# App Configuration
APP_NAME="FastAPI App"
ENVIRONMENT="development"  # development, staging, production
DEBUG=False
PORT=8000

# Database Settings
# For Sync PostgreSQL (e.g., psycopg2):
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# For Async PostgreSQL (e.g., asyncpg):
# ASYNC_DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/dbname"

# Individual Database Credentials (Optional if assembling URL dynamically)
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="dbname"

# Security / JWT
SECRET_KEY="change_this_to_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30